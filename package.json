{
    "name": "skillnomad-monorepo",
    "private": true,
    "workspaces": [
        "packages/*",
        "demos"
    ],
    "scripts": {
        "build": "tsc -b",
        "typecheck": "tsc -b --emitDeclarationOnly",
        "test": "node --test packages/skillnomad/test/steprefs.test.mjs packages/skillnomad/test/module-usage.test.mjs packages/skillnomad/test/renderstep-p1.test.mjs packages/skillnomad/test/checkpoint-conversion.test.mjs packages/skillnomad/test/decision-example.test.mjs packages/skillnomad/test/define-module.test.mjs packages/skillnomad/test/markrefs-bridge.test.mjs packages/skillnomad/test/markrefs-e2e.test.mjs packages/skillnomad/test/module-wiring.test.mjs packages/skillnomad/test/module-appendix.test.mjs packages/skillnomad/test/export-surface.test.mjs packages/skillnomad/test/blocks.test.mjs packages/skillnomad/test/structure.test.mjs packages/skillnomad/test/chain.test.mjs packages/skillnomad/test/package.test.mjs packages/skillnomad/test/body-sections.test.mjs",
        "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo dist",
        "demo": "npm run start --workspace=skillnomad-demo",
        "lint": "eslint .",
        "format": "eslint . --fix"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/node": "26.5.1",
        "eslint": "9.39.5",
        "eslint-plugin-jsonc": "3.4.2",
        "typescript": "5.9.3",
        "typescript-eslint": "8.70.0"
    }
}
