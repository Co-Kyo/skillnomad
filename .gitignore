# Dependencies
node_modules/
# （例外见下方两条强加软链：本地验证链配置，git add -f 一次性入库，
#  tracked 文件不受 ignore 规则影响；npm install 会覆盖软链装真实目录，
#  覆盖后 git status 即显示删除，开发者在 demo 目录重跑 link 脚本即可恢复。）

# Build output (packages)
packages/*/dist/

# TypeScript compiler output
dist/

# TypeScript build info
*.tsbuildinfo

# Marp build output (docs/slides)
docs/slides/slides.html
docs/slides/index.html
docs/slides/*.pdf

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
output/

# WorkBuddy 项目数据
.workbuddy/

# 文档站构建产物（TypeDoc/VitePress 生成，永不手写）
docs/api/reference/
docs/.vitepress/dist/
docs/node_modules/
docs/package-lock.json

# VitePress 临时配置与缓存
docs/.vitepress/config.ts.timestamp-*.mjs
docs/.vitepress/cache/

# Agent 本地私有覆盖（不入库）
agents.local.md

# Env secrets
.env
.env.*

# markrefs E2E fixture build output
packages/skillnomad/test/fixtures/*/out/
# demo 本地构建产物（源码入库，产物不入库）
demos/*/out/
demos/*/release/
