{
    "name": "markrefs",
    "version": "0.1.0",
    "description": "Markdown cross-reference resolution and validation (name to path, existence, duplicates)",
    "keywords": [
        "markdown",
        "cross-reference",
        "references",
        "dependencies",
        "validation",
        "lint"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "markrefs": "./bin/markrefs.mjs"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist",
        "bin"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Co-Kyo/skillnomad.git"
    },
    "bugs": {
        "url": "https://github.com/Co-Kyo/skillnomad/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc",
        "test": "node --test test/p0.test.mjs test/docgroup.test.mjs"
    }
