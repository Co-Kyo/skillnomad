{
    "entryPoints": [
        "../src/index.ts"
    ],
    "out": "api/reference",
    "plugin": [
        "typedoc-plugin-markdown"
    ],
    "readme": "none",
    "githubPages": false,
    "excludePrivate": true,
    "excludeInternal": true,
    "hideBreadcrumbs": true,
    "outputFileStrategy": "members",
    "categoryOrder": [
        "作者面",
        "发布布局",
        "内容包",
        "工具整合",
        "构建与渲染",
        "*"
    ],
    "compilerOptions": {
        "types": []
    },
    "skipErrorChecking": true
}